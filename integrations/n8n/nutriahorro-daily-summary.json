        "jsCode": "const data = $json.body ?? $json;\nconst message = data.message ?? [\n  '*nutrIAhorro | Resumen de hoy*',\n  `Hola ${data.user?.name ?? 'Lia'}.`,\n  '',\n  `*Usar primero:* ${(data.pantry?.use_first ?? ['pollo', 'tomate', 'palta']).join(', ')}`,\n  `*Comida sugerida:* ${data.meal?.name ?? 'Pollo con arroz, tomate y palta'}`,\n  `*Compra conveniente:* ${data.savings?.recommended_store ?? 'El Dorado'}`,\n  `*Ahorro estimado:* $${data.savings?.estimated_net_savings_uyu ?? 238} UYU`,\n  '',\n  '_Orientacion general. No sustituye asesoramiento medico o nutricional._'\n].join('\\n');\nreturn [{json:{event_id:data.event_id ?? crypto.randomUUID(), preview:message, ycloud_request:{from:data.channel?.whatsapp_from ?? 'REPLACE_BUSINESS_PHONE',to:data.user?.whatsapp_to ?? 'REPLACE_USER_PHONE',type:'text',text:{body:message,preview_url:false}}}}];"
      },
      "id": "3d053903-e899-47e5-a620-c2b5c18842c6",
